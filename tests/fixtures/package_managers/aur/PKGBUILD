# Maintainer: roethlar <https://github.com/roethlar>
pkgname=am-configurator-bin
pkgver=9.9.9
pkgrel=1
pkgdesc='Standalone Angry Miao keyboard configurator'
arch=('x86_64')
url='https://github.com/roethlar/AMKB-GUI'
license=('MIT')
# fuse2: AppImage runtime on typical Arch desktops
depends=('fuse2')
options=('!strip' '!debug')
install=am-configurator-bin.install
source=(
  'AM-Configurator-9.9.9-Linux-x86_64.AppImage::https://github.com/roethlar/AMKB-GUI/releases/download/v9.9.9/AM-Configurator-9.9.9-Linux-x86_64.AppImage'
  'am-configurator.desktop'
  'am-configurator.png'
  '60-am-neon-80.rules'
  'am-configurator.sh'
)
sha256sums=(
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  'b17b655985017d7b5f610f0e7a32feb475643a0b5036721aaeaf28cf7a6ee508'
  '67696d2d9d8517cb2ca6b444434f973ed86aa14326f85b1f9320d9d69194a043'
  'dd56cd88fc213e3962a7cf6ac7567d654f3a4bb2cc2656ef48d6fe7c27befa76'
  '08f7cf1128fe9c5e92418ac53ae944d771b99698871df9ba266885db3b4bb55c'
)

package() {
  install -Dm755 "${srcdir}/AM-Configurator-9.9.9-Linux-x86_64.AppImage" \
    "${pkgdir}/opt/am-configurator/AM-Configurator-9.9.9-Linux-x86_64.AppImage"
  install -Dm755 "${srcdir}/am-configurator.sh" \
    "${pkgdir}/usr/bin/am-configurator"
  install -Dm644 "${srcdir}/am-configurator.desktop" \
    "${pkgdir}/usr/share/applications/am-configurator.desktop"
  install -Dm644 "${srcdir}/am-configurator.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/am-configurator.png"
  install -Dm644 "${srcdir}/60-am-neon-80.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/60-am-neon-80.rules"
}
